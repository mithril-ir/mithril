  "ranking": [{ "rank": 0, "authored": "Member", "position": 0, "value": "Value0" }, { "rank": 1, "authored": "Admin", "position": 1, "value": "Value1" }],
  "bottom": { "rank": 0, "authored": "Member", "position": 0, "value": "Value0" },
