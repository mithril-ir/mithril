cabal-version:      3.0
name:               mithril-ir-api-probes
version:            0.1.0.0
synopsis:           Downstream probes of the mithril-ir API boundary
description:
  Downstream probes of the mithril-ir stage abstraction, written
  exactly as an external package would write them (depending on
  mithril-ir as an external package, never by adding its src/ to a
  module search path).  Two executables are legitimate
  external-consumer controls and must COMPILE — probe-control (the
  public pipeline) and probe-compatibility (the adapter surface as it
  was frozen before the Wasp Confinement Profile v1, next to the
  Profile-v1 APIs); the twenty-nine attack executables must each FAIL
  to compile for their intended boundary reason.  The driver
  test/api-probes/run-api-probes.sh builds them one by one and treats
  a failing control, a compiling attack, or an attack failing with an
  unintended message as a broken API boundary.
license:            Apache-2.0
author:             Mithril contributors
maintainer:         Mithril contributors
build-type:         Simple

-- Same rationale as the werror flag of mithril-ir itself: 'cabal
-- check' rejects an unconditional '-Werror', so the option sits
-- behind this manual flag, which cabal.project.probes switches on for
-- every probe build.
flag werror
  description: Treat GHC warnings as errors.
  manual:      True
  default:     False

-- Every probe component — the two controls and the twenty-nine
-- attacks — imports this stanza, so all thirty-one compile under the
-- same warning set as the repository's own components, with -Werror
-- active; the driver verifies both from the generated build plan and
-- from this file.
common probe
  default-language: GHC2021
  hs-source-dirs:   .
  build-depends:
    , aeson
    , base
    , bytestring
    , mithril-ir

  ghc-options:
    -Wall
    -Wcompat
    -Widentities
    -Wincomplete-record-updates
    -Wincomplete-uni-patterns
    -Wmissing-export-lists
    -Wpartial-fields

  if flag(werror)
    ghc-options: -Werror

-- Control: legitimate downstream use of the public pipeline.  This
-- one must COMPILE; the driver builds it first so that the attack
-- failures below cannot be explained by a broken probe environment.
executable probe-control
  import:  probe
  main-is: Control.hs

-- Compatibility control: the adapter surface frozen before the Wasp
-- Confinement Profile v1 (the legacy WaspBundleSummary view, its
-- three selectors, the two-argument WaspNotConfined outcome) used by
-- downstream source next to the Profile-v1 APIs.  This one must
-- COMPILE under the warning policy; the driver builds it right after
-- probe-control.
executable probe-compatibility
  import:  probe
  main-is: Compatibility.hs

-- Attack 1: import the hidden module that owns the CoreDocument
-- representation.
executable probe-hidden-import
  import:  probe
  main-is: HiddenImport.hs

-- Attack 2: use the CoreDocument constructor through the public
-- modules.
executable probe-constructor-use
  import:  probe
  main-is: ConstructorUse.hs

-- Attack 3: coerce a Parsed document to StructurallyValid.
executable probe-coerce-parsed
  import:  probe
  main-is: CoerceParsed.hs

-- Attack 4: coerce a StructurallyValid document to Resolved.
executable probe-coerce-valid
  import:  probe
  main-is: CoerceValid.hs

-- Attack 5: coerce a raw Aeson Value directly to CoreDocument
-- Resolved.
executable probe-coerce-value
  import:  probe
  main-is: CoerceValue.hs

-- Attack 6: import the hidden module that owns the explicit resolved
-- representation and its identifier types (also the only route to
-- constructing resolved nodes, minting identifiers, or coercing
-- between identifier namespaces — none of which can even be named
-- without this import).
executable probe-hidden-resolved
  import:  probe
  main-is: HiddenResolved.hs

-- Attack 7: import the hidden module that owns the decoded Core
-- surface syntax and the actor-availability contexts.
executable probe-hidden-syntax
  import:  probe
  main-is: HiddenSyntax.hs

-- Attack 8: coerce a resolved document back to a raw Aeson Value.
executable probe-extract-value
  import:  probe
  main-is: ExtractValue.hs

-- Attack 9: coerce a Resolved document to Typed, bypassing the
-- static typechecker.
executable probe-coerce-typed
  import:  probe
  main-is: CoerceTyped.hs

-- Attack 10: import the hidden module that owns the Core v0 static
-- typechecker.
executable probe-hidden-typecheck
  import:  probe
  main-is: HiddenTypecheck.hs

-- Attack 11: forge a Typed document with the CoreDocument
-- constructor.
executable probe-forge-typed
  import:  probe
  main-is: ForgeTyped.hs

-- Attack 12: coerce a Typed document to Normalized, bypassing the
-- normalizer.
executable probe-coerce-normalized
  import:  probe
  main-is: CoerceNormalized.hs

-- Attack 13: forge a Normalized document with the CoreDocument
-- constructor.
executable probe-forge-normalized
  import:  probe
  main-is: ForgeNormalized.hs

-- Attack 14: import the hidden module that owns the explicit typed
-- normalized representation (also the only route to constructing
-- normalized nodes or recovering the internal model, neither of
-- which can even be named without this import).
executable probe-hidden-normalized
  import:  probe
  main-is: HiddenNormalized.hs

-- Attack 15: import the hidden module that owns the Core v0
-- normalization pass.
executable probe-hidden-normalizer
  import:  probe
  main-is: HiddenNormalizer.hs

-- Attack 16: pass a merely Typed document to the public contract
-- renderer, bypassing normalization.
executable probe-contract-typed
  import:  probe
  main-is: ContractTyped.hs

-- Attack 17: import the hidden module that owns the Core v0
-- security-contract rendering pass.
executable probe-hidden-contract
  import:  probe
  main-is: HiddenContract.hs

-- Attack 18: pass a merely Typed document to the public verifier,
-- bypassing normalization.
executable probe-verify-typed
  import:  probe
  main-is: VerifyTyped.hs

-- Attack 19: import the hidden module that owns the verifier's
-- support gate, obligation generator, and checker-independent
-- orchestration (also the only route to the runner-injection seam).
executable probe-hidden-verify
  import:  probe
  main-is: HiddenVerify.hs

-- Attack 20: import the hidden module that owns the
-- compile-time-embedded trusted Agda kernel bytes.
executable probe-hidden-agda-kernel
  import:  probe
  main-is: HiddenAgdaKernel.hs

-- Attack 21: import the hidden module that owns the production Agda
-- checker runner (the verifier's file/process boundary).
executable probe-hidden-agda-checker
  import:  probe
  main-is: HiddenAgdaChecker.hs

-- Attack 22: pass a merely Parsed document to the public Wasp
-- emitter, bypassing every later stage.
executable probe-wasp-parsed
  import:  probe
  main-is: WaspParsed.hs

-- Attack 23: pass a merely StructurallyValid document to the public
-- Wasp emitter, bypassing resolution, typing, and normalization.
executable probe-wasp-valid
  import:  probe
  main-is: WaspValid.hs

-- Attack 24: pass a merely Resolved document to the public Wasp
-- emitter, bypassing typing and normalization.
executable probe-wasp-resolved
  import:  probe
  main-is: WaspResolved.hs

-- Attack 25: pass a merely Typed document to the public Wasp emitter,
-- bypassing normalization.
executable probe-wasp-typed
  import:  probe
  main-is: WaspTyped.hs

-- Attack 26: import the hidden module that owns the one shared
-- NoSelfPrivilegeEscalation support gate and plan.
executable probe-hidden-nspe-support-plan
  import:  probe
  main-is: HiddenNspeSupportPlan.hs

-- Attack 27: import the hidden module that owns the Wasp emitter (the
-- fixed target names, the templates, and the bundle constructor).
executable probe-hidden-wasp
  import:  probe
  main-is: HiddenWasp.hs

-- Attack 28: import the hidden module that owns the pure Wasp
-- confinement checker.
executable probe-hidden-wasp-confinement
  import:  probe
  main-is: HiddenWaspConfinement.hs

-- Attack 29: import the hidden module that owns the effectful Wasp
-- filesystem boundary (root validation, the snapshot walker, and the
-- installation swap with its fault-injection seam).
executable probe-hidden-wasp-filesystem
  import:  probe
  main-is: HiddenWaspFilesystem.hs
